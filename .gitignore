# ===================================================
# 🛡️ Kisan Setu - Repository Git Ignore Rules
# ===================================================

# 1. Environment Variables & Secrets (CRITICAL SECURITY)
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
**/.env
**/.env.*
**/*.env
!.env.example
!**/.env.example

# Private Keys & Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_ed25519
*.id_rsa
*.id_ed25519

# 2. Dependency Directories
node_modules/
*/node_modules/
**/node_modules/
jspm_packages/
package-lock.json.bak

# 3. Local Database & Runtime Files
data/
*.db
*.sqlite
*.sqlite3
*.pid
*.pid.lock
postmaster.pid
postgres_data/
redis_data/
.kisan-postgres/

# 4. Logs & Diagnostics (May leak auth tokens / personal data)
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. Testing & Code Coverage
coverage/
.nyc_output/

# 6. Build Outputs & Cache
dist/
build/
.cache/
.temp/
tmp/

# 7. Operating System Cache & Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# 8. IDE & Local Editor Settings
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
