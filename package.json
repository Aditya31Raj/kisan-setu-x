{
  "name": "kisan-setu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kisan Setu - Unified Agricultural Platform",
  "scripts": {
    "dev": "node start-dev.js",
    "start": "node start-dev.js",
    "build": "npm --prefix kisan-setu-backend run build",
    "dev:backend": "npm --prefix kisan-setu-backend run dev",
    "dev:frontend": "npm --prefix frontend start",
    "test": "npm --prefix kisan-setu-backend run test",
    "db:start": "node database/db-control.js start",
    "db:stop": "node database/db-control.js stop",
    "db:status": "node database/db-control.js status",
    "db:seed": "npm --prefix kisan-setu-backend run prisma:seed",
    "db:studio": "npm --prefix kisan-setu-backend run prisma:studio"
  }
}
